<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football">
    <Prefix name="" IRI="http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal>Kelompok Ontology Football Player in Europa : 
- Rahaditya Abimanyu Putra / 123230095
- Martin Aji Nugraha / 123230092
- Gusti Rama / 123230040
- Deni Norman Zaky / 123220165
- Hiero Purbandono / 123230086

===============================

SPARQL

1. Cek semua pemain

PREFIX ex: &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?Player 
WHERE {
    ?Player rdf:type ex:Player . 
}

2. Pemain manchester city

PREFIX ex: &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?player 
WHERE {
    ?player rdf:type ex:Player . 
    ?player ex:playsFor ex:Manchester_City . 
}

3. Pemain Senior yang Produktif

PREFIX ex: &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
SELECT ?player (STR(?gol) AS ?goalsClean)  (STR(?age) AS ?ageClean)
WHERE {
    ?player rdf:type ex:Player.
   ?player ex:hasGoals ?gol .
  ?player ex:age ?age 

   FILTER (isNumeric(?gol) &amp;&amp; ?gol &gt;=5  &amp;&amp; ?age &gt;=30)
}

4. Menampilkan pemain dari Italia dan menampilkan klubnya

PREFIX ex: &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?player ?club
WHERE {
    ?player rdf:type ex:Player . 
    ?player ex:hasNationality ex:Italy .
    ?player ex:playsFor ?club .
    ?club rdf:type ex:Club .
}

5. Mencari pelatih yang memiliki gaya main yang sama dengan gaya main sebuah klub

PREFIX : &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?Club ?Coach ?PlayStyle
WHERE {
    ?Club a :Club ;
          :clubHasPlayStyle ?PlayStyle .

    ?Coach a :ClubCoach ;
            :usesPlayStyle ?PlayStyle .
}

6. Mencari pelatih yang memiliki gaya main counter attack

PREFIX : &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?Coach
WHERE {
    ?Coach a :ClubCoach ;
           :usesPlayStyle :Counter_Attack.
}


7. Mencari pelatih yang memiliki banyak pencapaian

PREFIX : &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?Coach (STR(COUNT(?CoachAchievement)) AS ?TotalAchievements)
WHERE {
    ?Coach a :ClubCoach ;
           :coachWonAchievement ?CoachAchievement .
}
GROUP BY ?Coach
ORDER BY DESC(?TotalAchievements)

8. Mencari pelatih yang memiliki gaya counter attack dari negara Belanda

PREFIX : &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
SELECT ?Coach (STR(COUNT(?Achievement)) AS ?TotalAchievements)
WHERE {
    ?Coach a :ClubCoach ;
           :hasNationality :Netherlands ;
           :usesPlayStyle :Counter_Attack ;
           :coachWonAchievement ?Achievement .
}
GROUP BY ?Coach
HAVING (COUNT(?Achievement) &gt;= 1)
ORDER BY DESC(?TotalAchievements)

9. Mencari pelatih yang memiliki pengalaman melatih lebih dari 8 tahun dan berumur kurang 60 tahun

PREFIX ex: &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;

SELECT ?pelatih (STR(?lama_melatih) AS ?pengalaman) (STR(?age) AS ?umur) ?negara_asal 
WHERE {
    ?pelatih rdf:type ex:ClubCoach .   
    ?pelatih ex:coachingExperienceYears ?lama_melatih .
    ?pelatih ex:age ?age .
    ?pelatih ex:hasNationality ?negara_asal 

    FILTER (?lama_melatih &gt;= 8 &amp;&amp; ?age &lt;= 60)
}

10. Menampilkan negara yang memiliki memiliki jumlah pecapaian pelatih terbanyak

PREFIX ex: &lt;http://www.semanticweb.org/rahadityaputra/ontologies/2025/8/football#&gt;
PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;

SELECT 
    ?negaraAsal 
    (STR(?totalPencapaian) AS ?Total_Pencapaian_Negara)
    ?pelatihTerbaik 
    (STR(?pencapaianPelatihTerbaik) AS ?Pencapaian_Pelatih_Terbaik)
WHERE {
    {
        SELECT ?negaraAsal (COUNT(?pencapaianNegara) AS ?totalPencapaian)
        WHERE {
            ?pelatihNegara rdf:type ex:ClubCoach .
            ?pelatihNegara ex:hasNationality ?negaraAsal .
            OPTIONAL { ?pelatihNegara ex:coachWonAchievement ?pencapaianNegara . }
        }
        GROUP BY ?negaraAsal
    }
    {
        SELECT ?negaraAsal (SAMPLE(?pelatih) AS ?pelatihTerbaik) (MAX(?jumlahPencapaian) AS ?pencapaianPelatihTerbaik)
        WHERE {
            {
                SELECT ?pelatih ?negaraAsal (COUNT(?pencapaianPelatih) AS ?jumlahPencapaian)
                WHERE {
                    ?pelatih rdf:type ex:ClubCoach .
                    ?pelatih ex:hasNationality ?negaraAsal .
                    OPTIONAL { ?pelatih ex:coachWonAchievement ?pencapaianPelatih . }
                }
                GROUP BY ?pelatih ?negaraAsal 
            }
        }
        GROUP BY ?negaraAsal
    }
    
}
ORDER BY DESC(?totalPencapaian)</Literal>
